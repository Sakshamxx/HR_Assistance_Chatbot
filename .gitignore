# ===========================================================================
#  Secrets - never commit real API keys
#  (.env holds GOOGLE_API_KEY and GROQ_API_KEY; .env.example is safe to ship)
# ===========================================================================
.env
.env.*
!.env.example

# ===========================================================================
#  Python - virtual environment and bytecode
# ===========================================================================
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
build/
develop-eggs/
.eggs/
.Python
pip-log.txt

# Test / lint / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# Notebooks
.ipynb_checkpoints/

# ===========================================================================
#  Generated vector store - rebuild locally with `python ingest.py`
#  (Chroma writes a SQLite DB plus per-collection binary index files)
# ===========================================================================
chroma_db/
*.sqlite3
*.sqlite3-journal

# ===========================================================================
#  HR policy source documents.
#  Kept out of version control: these stand in for real internal company
#  files. Anyone cloning adds their own, per the README.
#  Delete the next two lines to publish the documents with the repo.
# ===========================================================================
knowledge_base/*
!knowledge_base/.gitkeep

# ===========================================================================
#  Node / React frontend
# ===========================================================================
node_modules/
dist/
dist-ssr/
.vite/
*.local

# npm / yarn / pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ===========================================================================
#  Logs and runtime noise
# ===========================================================================
*.log
logs/
*.pid
*.seed

# ===========================================================================
#  OS files
# ===========================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ===========================================================================
#  Editors and IDEs
# ===========================================================================
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ===========================================================================
#  AI assistant / tooling local state
# ===========================================================================
.claude/
.aider*
